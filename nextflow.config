manifest {
    version = '2.1.0'
}

// Default parameter values
params {
    kraken_db       = "/blue/bphl-florida/share/kraken2_databases/k2_standard_8GB_20260226"
    blast16s_db_dir = "${launchDir}/db/16s_blastdb"
}

// Stops the JVM writing hsperfdata, which crashes tasks when /tmp is full
env {
    _JAVA_OPTIONS = "-XX:-UsePerfData"
}

// Process-specific configs
process {
    withName: 'fastqc.*' {
        container = 'staphb/fastqc:0.12.1'
        cpus      = 2
        memory    = 4.GB
    }
    withName: trimmomatic {
        container = 'staphb/trimmomatic:0.40'
        cpus      = 4
    }
    withName: 'bbtools_.*' {
        container = 'staphb/bbtools:39.34'
        cpus      = 4
    }
    withName: 'multiqc.*' {
        container = 'staphb/multiqc:1.33'
        cpus      = 2
        memory    = 4.GB
    }
    withName: mash {
        container = 'staphb/mash:2.3-RefSeqProkv235'
        cpus      = 4
    }
    withName: unicycler {
        container     = 'staphb/unicycler:0.5.1'
        cpus          = 10
        memory        = 32.GB
        errorStrategy = 'ignore'
    }
    withName: kraken {
        container = 'staphb/kraken2:2.17.1'
        cpus      = 8
        memory    = 16.GB
    }
    withName: quast {
        container = 'staphb/quast:5.3.0'
        cpus      = 2
        memory    = 4.GB
    }
    withName: parse_assembly {
        cpus   = 1
        memory = 2.GB
    }
    withName: readssum {
        container = 'staphb/seqkit:2.14.0'
        cpus      = 2
        memory    = 4.GB
    }
    withName: prokka {
        container = 'staphb/prokka:1.15.6'
        cpus      = 4
    }
    withName: amrfinder {
        container = 'staphb/ncbi-amrfinderplus:4.2.7-2026-03-24.1'
        cpus      = 4
    }
    withName: mlst {
        container = 'staphb/mlst:2.32.2'
        cpus      = 2
        memory    = 4.GB
    }
    withName: pmga {
        container     = 'staphb/pmga:3.0.2'
        cpus          = 4
        errorStrategy = 'ignore'
    }
    withName: download_16s_db {
        container = 'staphb/blast:2.17.0'
        cpus      = 2
        memory    = 4.GB
    }
    withName: blast_16s {
        container = 'staphb/blast:2.17.0'
        cpus      = 4
    }
    withName: aggregate_species_id {
        cpus   = 1
        memory = 2.GB
    }
    withName: build_candidates {
        cpus   = 1
        memory = 2.GB
    }
    withName: candidate_references {
        container     = 'staphb/ncbi-datasets:18.9.0'
        cpus          = 2
        memory        = 4.GB
        maxForks      = 2
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: skani {
        container = 'staphb/skani:0.3.1'
        cpus      = 4
    }
    withName: resolve_ec_shigella {
        cpus   = 1
        memory = 2.GB
    }
    withName: legsta {
        container     = 'staphb/legsta:0.5.1'
        cpus          = 2
        memory        = 4.GB
        errorStrategy = 'ignore'
    }
    withName: kleborate {
        container     = 'staphb/kleborate:3.2.4'
        errorStrategy = 'ignore'
    }
    withName: shigatyper {
        container     = 'staphb/shigatyper:2.0.5'
        errorStrategy = 'ignore'
    }
    withName: emm_typing {
        container     = 'staphb/emm-typing-tool:0.0.1'
        errorStrategy = 'ignore'
    }
    withName: seqsero2 {
        container     = 'staphb/seqsero2:1.3.2'
        errorStrategy = 'ignore'
    }
    withName: serotypefinder {
        container     = 'staphb/serotypefinder:2.0.2'
        errorStrategy = 'ignore'
    }
    withName: plasmidfinder {
        container     = 'staphb/plasmidfinder:3.0.3'
        errorStrategy = 'ignore'
    }
    withName: seroba {
        container     = 'staphb/seroba:2.0.5'
        errorStrategy = 'ignore'
    }
    withName: pasty {
        container     = 'staphb/pasty:2.2.1'
        errorStrategy = 'ignore'
    }
    withName: 'kaptive_.*' {
        container     = 'staphb/kaptive:3.2.0'
        errorStrategy = 'ignore'
    }
    withName: lissero {
        container     = 'staphb/lissero:0.4.10'
        cpus          = 2
        memory        = 4.GB
        errorStrategy = 'ignore'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process {
            withName: emm_typing {
                containerOptions = { "-v ${task.workDir}:/EMBOSS-6.6.0/emboss/.libs" }
            }
        }
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
        process {
            withName: emm_typing {
                containerOptions = { "--bind ${task.workDir}:/EMBOSS-6.6.0/emboss/.libs" }
            }
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        process {
            withName: emm_typing {
                containerOptions = { "--bind ${task.workDir}:/EMBOSS-6.6.0/emboss/.libs" }
            }
        }
    }
}

// Run record, written into the output dir so it survives the sanibel.sh rename
trace {
    enabled   = true
    overwrite = true
    file      = "${params.output}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,process,tag,status,exit,attempt,duration,realtime,%cpu,peak_rss'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.output}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.output}/pipeline_info/timeline.html"
}

// Global error handling
process.errorStrategy = 'finish'